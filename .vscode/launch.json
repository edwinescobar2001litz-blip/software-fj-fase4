{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Software FJ: simulación (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Software FJ: modo interactivo (menu.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/menu.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Software FJ: pruebas unitarias",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["-v", "pruebas"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Software FJ: generar informe PDF",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generar_pdf.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
